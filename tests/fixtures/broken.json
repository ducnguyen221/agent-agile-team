{
  "_doc": "Ca hỏng cố ý cho check.py. Mỗi ca chép fixtures/valid/ sang thư mục tạm, áp đúng một thay đổi (replace: thay lần xuất hiện đầu tiên của old bằng new; write: ghi file mới), chạy check và đòi đúng mã luật + mã thoát. Mỗi luật của check có ít nhất một ca. Ca về sổ tập trung thêm `ledger` (nội dung file sổ trong kho riêng) và `env` (biến máy; `{store}` = đường kho).",
  "cases": [
    {"rule": "frontmatter-syntax", "exit": 2, "file": "PLAN.md", "line": 16,
     "replace": ["roles:\n  architect: [T1, agent-b]", "roles:\n  - role: architect"]},
    {"rule": "frontmatter-missing", "exit": 1, "file": "notes/SPEC.md", "line": 1,
     "write": {"notes/SPEC.md": "# SPEC viết tay\n\nKhông có frontmatter.\n"}},
    {"rule": "frontmatter-key-missing", "exit": 1, "file": "SPEC.md",
     "replace": ["risk: normal\n", ""]},
    {"rule": "frontmatter-value", "exit": 1, "file": "SPEC.md", "line": 8,
     "replace": ["status: approved", "status: finished"]},
    {"rule": "self-review", "exit": 1, "file": "SPEC.md",
     "replace": ["  business-reviewer: [T1, agent-c]", "  business-reviewer: [T1, agent-c]\n  researcher: [T3, agent-c]"]},
    {"rule": "frontmatter-key-unknown", "exit": 0, "file": "SPEC.md", "line": 5,
     "replace": ["sprint: SPR-03\n", "owner: someone\nsprint: SPR-03\n"]},
    {"rule": "heading-missing", "exit": 1, "file": "PLAN.md",
     "replace": ["## Rủi ro", "## Nguy cơ"]},
    {"rule": "conclusion-missing", "exit": 1, "file": "SPEC.md",
     "replace": ["> **Kết luận:**", "**Kết luận:**"]},
    {"rule": "id-bare-single-letter", "exit": 1, "file": "SPEC.md", "line": 54,
     "replace": ["- Xuất Excel.", "- Xuất Excel (ưu tiên P1)."]},
    {"rule": "id-unknown-prefix", "exit": 1, "file": "SPEC.md",
     "replace": ["| US1 (xuất nhanh) | Là kế toán", "| YC2 (tự chế) | Là ai đó, tôi muốn X, để Y | Nên có |\n| US1 (xuất nhanh) | Là kế toán"]},
    {"rule": "id-wrong-doc", "exit": 1, "file": "PLAN.md",
     "replace": ["| RK1 (dấu phẩy trong tên)", "| BR1 (vướng nhầm chỗ) | Ghi vướng mắc trong PLAN | Nên sửa | Chuyển sang PROGRESS |\n| RK1 (dấu phẩy trong tên)"]},
    {"rule": "xref-missing", "exit": 1, "file": "PLAN.md", "line": 50,
     "replace": ["(→ FR1.1, SC1)", "(→ FR1.1, FR9, SC1)"]},
    {"rule": "xref-unresolved", "exit": 0, "file": "PLAN.md",
     "replace": ["links:\n  spec: SPEC.md\n", "links:\n"]},
    {"rule": "task-without-trace", "exit": 1, "file": "PLAN.md",
     "replace": ["## Rủi ro", "### TK2 — Việc không trỏ spec\n\n- **TK2.1 (con):** kế thừa phần trỏ rỗng.\n\n## Rủi ro"]},
    {"rule": "report-sc-without-vr", "exit": 1, "file": "REPORT.md",
     "replace": ["| SC1 (xuất đủ cột) | File CSV có đủ ba cột | Test tự động của FR1 xanh |", "| SC1 (xuất đủ cột) | File CSV có đủ ba cột | Test tự động của FR1 xanh |\n| SC2 (có dòng tiêu đề) | Dòng đầu là tên cột | Test tự động |"],
     "target": "SPEC.md"},
    {"rule": "report-fr-without-vr", "exit": 1, "file": "REPORT.md",
     "replace": ["## 4. Tiêu chí thành công", "### FR2 — Lọc theo ngày (→ US1)\n\n- **FR2.1 (lọc):** KHI chọn ngày THÌ chỉ xuất đơn trong ngày.\n\n## 4. Tiêu chí thành công"],
     "target": "SPEC.md"},
    {"rule": "self-review", "exit": 1, "file": "SPEC.md",
     "replace": ["business-reviewer: [T1, agent-c]", "business-reviewer: [T1, agent-a]"]},
    {"rule": "qa-not-independent", "exit": 1, "file": "REPORT.md",
     "replace": ["qa: [T3, agent-f]", "qa: [T3, agent-e]"]},
    {"rule": "roles-invalid", "exit": 1, "file": "SPEC.md",
     "replace": ["analyst: [T1, agent-a]", "analyst: [T4, agent-a]"]},
    {"rule": "gate-invalid", "exit": 1, "file": "SPEC.md",
     "replace": ["gate_1_quote: \"duyệt\"", "gate_1_quote: null"]},
    {"rule": "old-scale-label", "exit": 1, "file": "REPORT.md",
     "replace": ["| Ghi chú | `export.py:12`", "| High | `export.py:12`"]},
    {"rule": "id-list-lead", "exit": 0, "file": "SPEC.md", "line": 36,
     "replace": ["SPEC có 1 **user story** (US):", "Câu chuyện:"]},
    {"rule": "doc-unknown", "exit": 0, "file": "memo.md",
     "write": {"memo.md": "---\nid: memo\ndoc: memo\n---\n\n# Ghi nhớ\n"}},
    {"rule": "config-syntax", "exit": 2, "file": ".agile.json",
     "write": {".agile.json": "{không phải json"}},
    {"rule": "config-invalid", "exit": 1, "file": ".agile.json",
     "write": {".agile.json": "{\"schema\": 1, \"coverage\": {\"line_min_percent\": 70, \"reason\": \"\"}}"}},
    {"rule": "config-public-root", "exit": 1, "file": ".agile.json",
     "write": {".agile.json": "{\"schema\": 1, \"visibility\": \"public\", \"artifact_root\": \"docs\"}"}},
    {"rule": "config-invalid", "exit": 1, "file": ".agile.json",
     "write": {".agile.json": "{\"schema\": 1, \"paths\": {\"requests\": \"../../ngoai/REQUESTS.md\"}}"}},
    {"rule": "frontmatter-key-missing", "exit": 1, "file": "notes/PLAN.md", "line": 1,
     "write": {"notes/PLAN.md": "---\ntitle: Kế hoạch viết tay\n---\n\n# Kế hoạch\n"}},
    {"rule": "frontmatter-value", "exit": 1, "file": "notes/SPRINTS.md", "line": 5,
     "write": {"notes/SPRINTS.md": "---\nid: SPRINTS\ndoc: sprints\ntitle: Sprint ledger\nnext_id: SPR-1\nupdated: 2026-02-01\n---\n\n# Sổ sprint\n\n## Đang mở\n\n<!-- agile:open:start -->\nKhông có sprint nào đang mở.\n<!-- agile:open:end -->\n\n## Timeline\n"}},
    {"rule": "sprint-size-mismatch", "exit": 1, "file": "SPEC.md",
     "replace": ["size: medium", "size: tiny"]},
    {"rule": "ledger-missing-row", "exit": 1, "file": "PROGRESS.md",
     "write": {".agile.json": "{\"schema\": 1, \"ledger\": {\"project\": \"order-desk\"}}"},
     "env": {"AGENT_AGILE_LEDGER": "{store}/{project}.md"},
     "ledger": "# Sổ\n\n## Sprint\n\n| Sprint | Trạng thái | Cập nhật | Hồ sơ | Link |\n|---|---|---|---|---|\n| SPR-09 | verifying | 2026-02-02 | order-desk:docs/plans/x/PROGRESS.md | y |\n"},
    {"rule": "ledger-stale", "exit": 1, "file": "PROGRESS.md",
     "write": {".agile.json": "{\"schema\": 1, \"ledger\": {\"project\": \"order-desk\"}}"},
     "env": {"AGENT_AGILE_LEDGER": "{store}/{project}.md"},
     "ledger": "# Sổ\n\n## Sprint\n\n| Sprint | Trạng thái | Cập nhật | Hồ sơ | Link |\n|---|---|---|---|---|\n| SPR-03 | in_progress | 2026-02-02 | order-desk:docs/plans/x/PROGRESS.md | y |\n"},
    {"rule": "ledger-unreadable", "exit": 1, "file": ".agile.json",
     "write": {".agile.json": "{\"schema\": 1, \"ledger\": {\"project\": \"order-desk\"}}"},
     "env": {"AGENT_AGILE_LEDGER": "{store}/{project}.md"},
     "ledger": "# Sổ không có bảng sprint\n"},
    {"rule": "ledger-unconfigured", "exit": 0, "file": ".agile.json",
     "write": {".agile.json": "{\"schema\": 1, \"ledger\": {\"project\": \"order-desk\"}}"}},
    {"name": "thiếu lời cấp", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["  grant: \"Cho phép T1 duyệt thay Cổng 1 của SPR-03 tới hết sprint.\"\n", ""]},
    {"name": "phạm vi không chứa cổng", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["scope: [gate_1]", "scope: [gate_2]"]},
    {"name": "quá hạn", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["expires: sprint_end", "expires: 2026-01-31"]},
    {"name": "đã thu hồi trước cổng", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["revoked_at: null", "revoked_at: 2026-02-01 08:45 +07"]},
    {"name": "lời cấp sau thời điểm cổng", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["grant_at: 2026-02-01 08:30 +07", "grant_at: 2026-02-01 09:30 +07"]},
    {"name": "quote sai tiền tố", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["gate_1_quote: \"duyệt thay: chọn phương án a — xem mục Bản ghi duyệt thay\"", "gate_1_quote: \"duyệt\""]},
    {"name": "người duyệt không phải T1", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["tier: T1", "tier: T2"]},
    {"name": "thiếu mục bản ghi", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["## Bản ghi duyệt thay", "## Ghi chú khác"]},
    {"name": "thiếu nhãn Nếu sai thì tốn gì", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["**Nếu sai thì tốn gì:**", "**Hậu quả:**"]},
    {"name": "risk_tags có secret", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["risk_tags: []", "risk_tags: [secret]"]},
    {"name": "risk_tags có rules mà files rỗng", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["risk_tags: []", "risk_tags: [rules]"]},
    {"name": "người duyệt trùng nhãn vai thực thi", "rule": "self-review", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["by: agent-d", "by: agent-b"]},
    {"name": "gate_1_mode ngoài miền", "rule": "frontmatter-value", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["gate_1_mode: delegated", "gate_1_mode: auto"]},
    {"name": "thời điểm cấp không đọc được", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["grant_at: 2026-02-01 08:30 +07", "grant_at: hôm qua"]},
    {"name": "người duyệt chưa giao", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["by: agent-d", "by: pending"]},
    {"name": "khối delegation vắng", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["delegation:\n  grant: \"Cho phép T1 duyệt thay Cổng 1 của SPR-03 tới hết sprint.\"\n  grant_at: 2026-02-01 08:30 +07\n  scope: [gate_1]\n  expires: sprint_end\n  by: agent-d\n  tier: T1\n  files: []\n  revoked_at: null\n", ""]},
    {"name": "khoá lạ trong delegation", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["  files: []\n", "  files: []\n  note: x\n"]},
    {"name": "Cổng 2 của REPORT: phạm vi chỉ gate_1", "rule": "gate-delegation-invalid", "exit": 1, "file": "REPORT.md", "base": "delegated-report",
     "replace": ["scope: [gate_2]", "scope: [gate_1]"]},
    {"name": "thời điểm cổng không đọc được", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["gate_1_at: 2026-02-01 09:00 +07", "gate_1_at: sáng nay"]},
    {"name": "hạn không đọc được", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["expires: sprint_end", "expires: tuần sau"]},
    {"name": "files không phải danh sách", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["files: []", "files: AGENTS.md"]},
    {"name": "thời điểm thu hồi không đọc được", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["revoked_at: null", "revoked_at: hôm qua"]},
    {"name": "thời điểm cấp là ngày không có thật", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["grant_at: 2026-02-01 08:30 +07", "grant_at: 2026-02-30 08:30 +07"]},
    {"name": "thu hồi chỉ ghi ngày, trùng ngày cổng", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated",
     "replace": ["revoked_at: null", "revoked_at: 2026-02-01"]},
    {"name": "TK trỏ Đầu vào của việc sau", "rule": "task-order", "exit": 1, "file": "PLAN.md", "replace": ["## Rủi ro", "### TK2 — Việc trỏ tới (→ FR1.1)\n\n- **Đầu vào:** TK3.\n\n### TK3 — Việc sau (→ FR1.1)\n\n- **Đầu vào:** TK1.\n\n## Rủi ro"]},
    {"name": "số TK cấp một hụt số", "rule": "task-gap", "exit": 0, "file": "PLAN.md", "replace": ["## Rủi ro", "### TK3 — Việc nhảy số (→ FR1.1)\n\n- **Đầu vào:** TK1.\n\n## Rủi ro"]},
    {"name": "mục Mục tiêu thiếu nhãn thứ ba", "rule": "plan-goal-block", "exit": 0, "file": "PLAN.md", "replace": ["- **Rủi ro cần chú ý:** tên khách có dấu phẩy làm lệch cột — RK1 (dấu phẩy trong tên).\n", ""]},
    {"name": "quote duyệt thay mà không khai mode", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md",
     "replace": ["gate_1_quote: \"duyệt\"", "gate_1_quote: \"Duyệt thay: chọn phương án a\""]},
    {"name": "khối delegation mà không khai mode", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md",
     "replace": ["gate_1_quote: \"duyệt\"\n", "gate_1_quote: \"duyệt\"\ndelegation:\n  grant: \"Cho phép T1 duyệt thay Cổng 1 của SPR-03 tới hết sprint.\"\n  scope: [gate_1]\n"]},
    {"name": "duyệt thay mà thiếu risk_tags", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated", "replace": ["risk_tags: []\n", ""]},
    {"name": "duyệt thay mà risk_tags là chuỗi đơn", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated", "replace": ["risk_tags: []", "risk_tags: secret"]},
    {"name": "người duyệt thay không có trong roles", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated", "replace": ["  by: agent-d\n", "  by: agent-x\n"]},
    {"name": "người duyệt thay chỉ giữ vai thực thi", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated", "replace": ["  tech-reviewer: [T1, agent-d]", "  researcher: [T1, agent-d]"]},
    {"name": "người duyệt thay giữ vai kiểm định nhưng không phải T1", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated", "replace": ["  tech-reviewer: [T1, agent-d]", "  tech-reviewer: [T2, agent-d]"]},
    {"name": "cổng còn pending mà delegation có khoá lạ", "rule": "gate-delegation-invalid", "exit": 1, "file": "PLAN.md", "base": "delegated", "replaces": [["status: approved", "status: draft"], ["gate_1: approved", "gate_1: pending"], ["  files: []\n", "  files: []\n  note: x\n"]]}
  ]
}
