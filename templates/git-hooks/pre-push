#!/bin/sh
# pre-push mẫu (SPR-16 TK10, lớp độc lập thứ hai của method/git-permissions.md mục 10): từ chối đẩy vào nhánh được bảo vệ.
# KHÔNG đi qua agent và KHÔNG phụ thuộc hook của harness, nên chặn cả đường script mà guard không nhìn thấy.
# Cài vào repo thật là việc của người dùng, từng repo: sao file này thành .git/hooks/pre-push (chmod +x trên Unix).
#
# Nhánh được bảo vệ: main, master, cộng danh sách trong `git config agile.protectedBranches` (tách bằng dấu phẩy hay khoảng trắng).
# Git đưa vào stdin mỗi dòng: <local ref> <local sha> <remote ref> <remote sha>. Chỉ xét <remote ref>.
# Lách bằng `git push --no-verify` là có thật: đó là lý do còn lớp (b) ở máy chủ (ruleset hay hook pre-receive).

protected="main master"
extra=$(git config --get agile.protectedBranches 2>/dev/null | tr ',' ' ')
protected="$protected $extra"

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$remote_ref" ] || continue
  for name in $protected; do
    if [ "$remote_ref" = "refs/heads/$name" ]; then
      echo "pre-push: từ chối đẩy vào nhánh được bảo vệ '$name' — đẩy nhánh sprint rồi mở PR; gộp vào '$name' do người dùng quyết" >&2
      status=1
    fi
  done
done
exit $status
