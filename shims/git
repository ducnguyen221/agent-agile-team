#!/bin/sh
# Shim git (SPR-16b): kiem argv that roi moi chay git that. Chi chan khi AGENT_AGILE_SHIM khac rong/0 VA thu muc hien tai nam trong repo co .agile.json
# (hoac .tmp/autopilot.json, hoac dat AGENT_AGILE_PROTECTED_REPOS); con lai chay git that ngay, khong khoi dong Python (nguoi dung o terminal khong bi anh huong).
here=${0%/*}
[ "$here" = "$0" ] && here=.

run_real() {
  oldifs=$IFS; IFS=:; set -f
  for d in $PATH; do
    c=$d/git
    if [ -x "$c" ] && ! [ "$c" -ef "$0" ]; then IFS=$oldifs; exec "$c" "$@"; fi
  done
  IFS=$oldifs
  echo "git-shim: khong tim thay git that tren PATH" >&2
  exit 127
}

active=0
if [ -n "$AGENT_AGILE_SHIM" ] && [ "$AGENT_AGILE_SHIM" != 0 ]; then active=1; fi
if [ "$active" = 1 ] && [ -z "$AGENT_AGILE_PROTECTED_REPOS" ]; then
  found=0
  cur=$PWD
  while :; do
    if [ -e "$cur/.agile.json" ] || [ -e "$cur/.tmp/autopilot.json" ]; then found=1; break; fi
    [ -e "$cur/.git" ] && break
    parent=${cur%/*}
    [ -z "$parent" ] && parent=/
    [ "$parent" = "$cur" ] && break
    cur=$parent
  done
  [ "$found" = 1 ] || active=0
fi
[ "$active" = 1 ] || run_real "$@"

AGENT_SHIM_DIR=$(cd "$here" 2>/dev/null && pwd) || exit 127
export AGENT_SHIM_DIR
for py in python3 python; do
  found=$(command -v "$py" 2>/dev/null) || continue
  case $found in *[Ww]indows[Aa]pps*) continue ;; esac
  exec "$py" "$AGENT_SHIM_DIR/../scripts/git_shim.py" git "$@"
done
echo "git-shim: khong co Python - tu choi" >&2
exit 1
